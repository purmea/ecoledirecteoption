{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.mjs": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path((?!ed$|profiles$).*)",
      "destination": "/api/profiles?p=:path"
    }
  ],
  "regions": [
    "cdg1"
  ]
}